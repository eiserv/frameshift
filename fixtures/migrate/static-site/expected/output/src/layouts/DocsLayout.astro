---
import RootLayout from './RootLayout.astro';

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
---
<RootLayout title={title} description={description}>
  <div class="docs">
    <nav>Documentation</nav>
    <article>
      <slot />
    </article>
  </div>
</RootLayout>
