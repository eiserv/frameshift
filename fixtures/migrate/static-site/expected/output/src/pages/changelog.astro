---
import Stamp from '../components/Stamp.astro';
import { siteName } from '../lib/site';
import RootLayout from '../layouts/RootLayout.astro';

const offset = 1;
// Resolved before the markup renders.
const entries = await Promise.resolve(['First release']);
const heading = `${siteName}: ${entries.length + offset} entries`;
---
<RootLayout title="Changelog | Lumen Studio" description="A small, fictional design studio.">
  <section>
    <h1>
      {heading}
    </h1>
    <Stamp />
  </section>
</RootLayout>
