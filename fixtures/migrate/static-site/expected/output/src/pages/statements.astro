---
import RootLayout from '../layouts/RootLayout.astro';

const items = ['first', 'second'];
// An expression statement keeps its place before the markup.
items.reverse();
---
<RootLayout title="Statements | Lumen Studio" description="A small, fictional design studio.">
  <ul>
    {items.map((item) => (
        <li>{`${item}`}</li>
      ))}
  </ul>
</RootLayout>
