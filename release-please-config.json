        { "type": "toml", "path": "Cargo.lock", "jsonpath": "$.package[?(@.name.value=='frameshift-evaluate')].version" },
        { "type": "toml", "path": "Cargo.lock", "jsonpath": "$.package[?(@.name.value=='frameshift-entity-gen')].version" },
        { "type": "toml", "path": "Cargo.lock", "jsonpath": "$.package[?(@.name.value=='frameshift-fuzz')].version" },
        { "type": "toml", "path": "Cargo.lock", "jsonpath": "$.package[?(@.name.value=='frameshift-fuzz-sections')].version" },
        { "type": "toml", "path": "Cargo.lock", "jsonpath": "$.package[?(@.name.value=='frameshift-input')].version" },
        { "type": "toml", "path": "Cargo.lock", "jsonpath": "$.package[?(@.name.value=='frameshift-modules')].version" },
        { "type": "toml", "path": "Cargo.lock", "jsonpath": "$.package[?(@.name.value=='frameshift-nextjs')].version" },
