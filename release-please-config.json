        { "type": "toml", "path": "Cargo.lock", "jsonpath": "$.package[?(@.name.value=='frameshift-corpus')].version" },
        { "type": "toml", "path": "Cargo.lock", "jsonpath": "$.package[?(@.name.value=='frameshift-e2')].version" },
        { "type": "toml", "path": "Cargo.lock", "jsonpath": "$.package[?(@.name.value=='frameshift-emit')].version" },
