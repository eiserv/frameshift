{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Frameshift error document",
  "description": "A command failure. The current shell emits usage failures with exitCode 2.",
  "type": "object",
  "required": ["kind", "schemaVersion", "exitCode", "message"],
  "properties": {
    "kind": { "const": "frameshift.error" },
    "schemaVersion": { "const": 1 },
    "exitCode": { "enum": [2, 3, 4, 5, 6, 70] },
    "message": { "type": "string", "minLength": 1 }
  }
}
